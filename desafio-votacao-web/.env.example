# Docker Compose. Copie para .env quando precisar alterar os valores.
WEB_PORT=4200
# Backend no host Docker; pode ser substituido por api.sua-rede:8080.
API_UPSTREAM=host.docker.internal:8080

# npm start: exporte API_TARGET no terminal. Angular CLI nao le este .env.
# Exemplo PowerShell: $env:API_TARGET = 'http://localhost:8080'