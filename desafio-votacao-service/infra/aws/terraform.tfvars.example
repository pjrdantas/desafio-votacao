aws_region  = "us-east-2"
environment = "demo"

# Use "apto" para uma demonstração determinística.
cpf_fake_mode = "apto"

# Ative após criar o frontend para que o contrato mobile use o domínio HTTPS.
# public_base_url = "https://d1234567890.cloudfront.net"

# Opcional: exportação direta de métricas para Dynatrace.
# dynatrace_metrics_uri          = "https://SEU-AMBIENTE.live.dynatrace.com/api/v2/metrics/ingest"
# dynatrace_api_token_secret_arn = "arn:aws:secretsmanager:us-east-2:123456789012:secret:dynatrace-token"

# Para ambiente permanente:
# database_multi_az = true
# protect_data      = true
# api_allowed_cidrs = ["SEU_IP_PUBLICO/32"]