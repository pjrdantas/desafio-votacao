DB_PORT=5433
DB_PASSWORD=votacao
SERVER_PORT=8080
MOBILE_BASE_URL=http://localhost:8080

# Usado somente ao adicionar compose.dynatrace.yaml.
APP_ENV=local
DYNATRACE_METRICS_URI=https://SEU-AMBIENTE.live.dynatrace.com/api/v2/metrics/ingest
# Preencher somente no .env local. Escopo: metrics.ingest.
DYNATRACE_API_TOKEN=
DYNATRACE_METRICS_STEP=30s
# Opcional: injeção na imagem com compose.dynatrace-agent.yaml.
# Obter o endereço exato no Dynatrace; autenticar com docker login.
DT_ONEAGENT_IMAGE=SEU-REGISTRY/linux/oneagent-codemodules-musl:java

# Autenticação local; chave no volume jwt-keys do Compose.
JWT_ISSUER=urn:desafio-votacao-service
AUTH_COOKIE_SECURE=false
AUTH_RATE_LIMIT=120
# aleatorio segue o bônus; apto/inapto tornam a demonstração determinística.
CPF_FAKE_MODO=aleatorio
